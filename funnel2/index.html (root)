<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>ClickSuccessLab Funnel 2</title>
  <script>
    // Redirect to the thank-you page after form submission
    function redirectAfterSubmit(event) {
      event.preventDefault();
      const form = event.target;

      fetch(form.action, {
        method: "POST",
        body: new FormData(form)
      })
      .then(() => { window.location.href = "thanks.html"; })
      .catch(() => { alert("Something went wrong. Please try again."); });
    }
  </script>
  <style>
    body { font-family: Arial, sans-serif; max-width: 680px; margin: 40px auto; }
    h1 { margin-bottom: 16px; }
    input, button { font-size: 16px; padding: 12px; margin: 6px 0; width: 100%; }
    button { cursor: pointer; }
  </style>
</head>
<body>
  <h1>Funnel 2 Signup</h1>

  <form action="https://clkaffl237.app.n8n.cloud/webhook/clicksuccess-lead"
        method="POST"
        onsubmit="redirectAfterSubmit(event)">
    <input type="text" name="name" placeholder="Your Name" required />
    <input type="email" name="email" placeholder="Your Email" required />
    <button type="submit">Get Instant Access</button>
  </form>

  <!-- connect funnel 2 form to n8n webhook -->
</body>
</html>
